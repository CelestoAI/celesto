OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Temporary release gate. Leave off unless you are running the approved
# OpenAI account sign-in development smoke.
OPEN_MUSE_ENABLE_SUBSCRIPTION_AUTH=0
CELESTO_RUNTIME=./scripts/source-celesto-runtime.sh
OPENMUSE_COMPUTER_PROVIDER=local
# Required only when OPENMUSE_COMPUTER_PROVIDER=celesto.
CELESTO_API_KEY=
# Optional development or self-hosted Celesto control plane.
# CELESTO_API_URL=
OPEN_MUSE_HOST=127.0.0.1
OPEN_MUSE_PORT=4318
# Additional LLM providers (optional — set whichever you want to use).
# Each key is picked up automatically; you can also enter it through the setup screen.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=