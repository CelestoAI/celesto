OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Temporary release gate. Leave off unless you are running the approved
# OpenAI account sign-in development smoke.
OPEN_MUSE_ENABLE_SUBSCRIPTION_AUTH=0
SMOLVM_RUNTIME=./scripts/source-smolvm-runtime.sh
OPENMUSE_COMPUTER_PROVIDER=smolvm
# Required only when OPENMUSE_COMPUTER_PROVIDER=celesto.
CELESTO_API_KEY=
# Optional development or self-hosted Celesto control plane.
# CELESTO_API_URL=
OPEN_MUSE_HOST=127.0.0.1
OPEN_MUSE_PORT=4318
