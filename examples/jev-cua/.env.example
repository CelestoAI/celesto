# Choose openai, gateway, or custom. No automatic fallback between providers.
LLM_PROVIDER=openai
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
# Defaults: gpt-5.6-luna (OpenAI), openai/gpt-5.6-luna (Gateway).
INVESTIGATOR_MODEL=
EVALUATOR_MODEL=
WRITER_MODEL=
# Custom provider only:
LLM_BASE_URL=
LLM_API_KEY=
# Jev uses Gateway when AI_GATEWAY_API_KEY exists. Direct TypeSafe is optional.
JEV_PROVIDER=gateway
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Needed only for cloud runs. Templates must support Linux shell commands.
CELESTO_API_KEY=
CELESTO_TEMPLATE=coding-agent
