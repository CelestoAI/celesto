# GitHub App with Actions read and repository Administration write.
GITHUB_REPOSITORY=OWNER/PRIVATE_REPO
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/root/celesto-ci/github-app.pem

# For a private pilot only, GITHUB_TOKEN can replace the three App settings.
# GITHUB_TOKEN=

# Use a Celesto organization reserved for this controller and its job computers.
CELESTO_API_KEY=
CELESTO_ORGANIZATION_ID=
CELESTO_BASE_URL=https://api.celesto.ai
CELESTO_CONTROLLER_COMPUTER_ID=

# Store this on the controller computer's persistent disk.
CELESTO_CI_STATE_DB=/root/celesto-ci/jobs.sqlite3
